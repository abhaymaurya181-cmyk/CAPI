    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/tasks": "^5.4.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "google-ads-api": "^17.0.1",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
