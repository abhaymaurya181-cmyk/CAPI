{
  "name": "lucira-capi",
  "version": "0.1.0",
  "private": true,
  "description": "Lucira Jewellery server-side conversion tracking (Meta CAPI + Google Ads)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
