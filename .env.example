# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# GCP
GOOGLE_CLOUD_PROJECT=lucira-capi-dev
# Local Firestore emulator (unset to use real GCP)
FIRESTORE_EMULATOR_HOST=localhost:8181

# Admin
ADMIN_USERNAME=admin
LUCIRA_CREDS_CAPI=dev-admin-token
INTERNAL_TOKEN=dev-internal-token

# Click attribution: which stored click is sent per platform — "last" (default) or "first"
CLICK_MODE=last
# Only credit an ad click made within this many days before the sale
CLICK_WINDOW_DAYS=90

# Meta Conversions API
# Dataset ID = the Meta Pixel ID in Events Manager
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Only while testing (Events Manager → Test Events); leave empty in production
META_TEST_EVENT_CODE=
META_API_VERSION=v20.0

# Google Ads via Data Manager API (step 4)
# 10-digit customer id, no dashes, of the account that owns the conversion action
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) account id the service account is added to; empty if added directly
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# "Purchase" conversion action id (Website, Primary). All sales — store + web — report here.
GOOGLE_ADS_CONVERSION_ACTION_PURCHASE=
# Service account key file for local dev. On Cloud Run leave empty — the
# attached service account is used. It must be added as a user in Google Ads.
GOOGLE_APPLICATION_CREDENTIALS=
# true = Data Manager validateOnly (checks payload, sends nothing). Set false to go live.
GOOGLE_VALIDATE_ONLY=true

# OrnaVerse POS (step 5) — Lucira's PRODUCTION tenant, read-only use.
# Real client id/secret go only in .env, never here (they can't be rotated).
# ORNAVERSE_API_BASE=https://lucira.live.ornaverse.in
ORNAVERSE_API_BASE=
ORNAVERSE_CLIENT_ID=
ORNAVERSE_CLIENT_SECRET=
# OAuth2 scope. OpenIddict requires at least one; Lucira's tenant uses "openid".
ORNAVERSE_SCOPE=openid
# Comma-separated document_status int codes to keep. Lucira's live tenant
# uses 1 = posted (observed: 97%% of rows) and 2 = other (likely returns/
# cancels, 3%%). Pushed server-side via EqualityFilter. Unset or invalid →
# 1 only (returns are never imported as sales).
ORNAVERSE_POSTED_STATUSES=1
# How often the offline-order sync runs (Cloud Scheduler cron, Asia/Kolkata)
SYNC_SCHEDULE=0 * * * *
# First sync (no cursor yet) imports sales from this many days back
ORNAVERSE_INITIAL_LOOKBACK_DAYS=7
# Every hourly sync also re-reads bills dated this many days back and imports
# only new ones (backdated bills / drafts posted later — Lucira: max 2–3 days). 0–7.
ORNAVERSE_HOURLY_LOOKBACK_DAYS=3
# Daily safety re-scan: re-read bills dated in the last N days and import any
# we never recorded (backdated / missed bills). 1–60, default 30 (Meta limit 62).
ORNAVERSE_RESCAN_DAYS=30
# When the re-scan runs (Cloud Scheduler cron, Asia/Kolkata). Keep it off the hour.
RESCAN_SCHEDULE=30 3 * * *
