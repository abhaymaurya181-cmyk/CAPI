# Files never uploaded to Cloud Build (gcloud builds submit).
# Explicit on purpose: secrets and private vendor docs must not leave this machine,
# even if .gitignore changes.
.env
.env.*
!.env.example
service-account*.json
# Google service-account keys under any name, e.g. lucira-capi-sender-key.json
*-key.json
*-key*.json
# Zipped private docs
*.zip
ornaverse-api-docs/
api-dog*
.git
.gitignore
node_modules/
dist/
coverage/
*.log
